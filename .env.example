# --- LLM (Google Gemini) ---
GEMINI_API_KEY=AIza...
LLM_MODEL=gemini-2.0-flash
USE_MOCK_LLM=true          # true = no API key needed, uses deterministic mock responses

# --- Database ---
DATABASE_URL=postgresql://talentflow:talentflow@localhost:5432/talentflow

# --- Feature flags for external integrations (mock by default) ---
USE_MOCK_CALENDAR=true
USE_MOCK_EMAIL=true

# --- FAISS vector store ---
FAISS_INDEX_PATH=data/candidates.index

# --- Scoring thresholds ---
RESUME_PASS_THRESHOLD=0.62
ASSESSMENT_PASS_THRESHOLD=0.70
